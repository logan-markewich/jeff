# Copy to .env (docker compose loads it automatically). Every JEFF_* variable
# below is passed straight into the container via docker-compose.yml's
# env_file, so anything you set here takes effect without editing the
# compose file. Commented lines show the server's built-in default -
# uncomment and change only what you need. Full descriptions: README.md
# "Configuration".
#
# NOTE: JEFF_HOST and JEFF_PORT are pinned to 0.0.0.0/8000 inside
# docker-compose.yml (the container always listens on 8000 internally), so
# setting them here has no effect. To change the port exposed on the host,
# use JEFF_PORT below - it's also used for the "host:container" port mapping.

### Core ##########################################################

# Comma-separated bearer keys. Leave empty/unset to disable auth (local dev only).
JEFF_API_KEYS=devkey

# Host port docker-compose publishes (container always listens on 8000).
JEFF_PORT=8000

# Local checkpoint path inside the container. Matches the "models" volume
# mount point (/app/models/...) - change together with the Dockerfile/volume
# if you move it.
# JEFF_MODEL=models/gliformer-large-v1

# Repo entrypoint.sh downloads if JEFF_MODEL is empty (not a jeff server
# setting - consumed by docker/entrypoint.sh only).
# JEFF_MODEL_REPO=knowledgator/gliformer-large-v1

# cuda | mps | cpu. Default: auto-detect (CUDA -> MPS -> CPU).
# JEFF_DEVICE=

### Batching / limits ##############################################

# JEFF_MAX_BATCH=16
# JEFF_MAX_WAIT_MS=5
# JEFF_MAX_QUEUE=256

# Per-key rate limit; 0 disables.
# JEFF_RATE_LIMIT_RPS=0
# JEFF_RATE_LIMIT_BURST=20

# Requests exceeding these return 422.
# JEFF_MAX_QUESTIONS=64
# JEFF_MAX_LABELS=64
# JEFF_MAX_STATE_CHARS=20000

### Model / backend tuning #########################################

# Name reported in responses and GET /v1/models.
# JEFF_MODEL_NAME=gliformer-large-v1

# Comma-separated request model aliases accepted alongside JEFF_MODEL_NAME.
# JEFF_MODEL_ALIASES=jev-latest,jev

# torch | onnx
# JEFF_BACKEND=torch

# Model precision. Default: bf16 on CUDA, fp32 elsewhere.
# JEFF_DTYPE=

# Probability calibration; 1 disables scaling.
# JEFF_TEMPERATURE=3.2

# none | nouls | all - which questions get separate encoder passes.
# JEFF_ISOLATE=nouls

# yes_no | single | single_named
# JEFF_NOUL_MODE=yes_no

# kv | json | values
# JEFF_STATE_FORMAT=kv

# auto | flash (CUDA only) | eager
# JEFF_ATTN=auto

# JEFF_COMPILE=0
# JEFF_COMPILE_MODE=
# JEFF_PAD_MULTIPLE=0
# JEFF_WARMUP=0

### CPU / ONNX backend (JEFF_BACKEND=onnx) #########################

# fp32 | int8
# JEFF_QUANT=fp32
# JEFF_THREADS=
# JEFF_ONNX_PATH=
